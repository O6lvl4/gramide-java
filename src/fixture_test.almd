import gramide.parser
import gramide.tree
import gramide.tags
import self.grammar
import self.lexer
import self.symbols
import self.table

test "generics.java core declarations and bodies parse" {
  let source = "import java.util.*;\npublic interface Repository<K, V> extends AutoCloseable {\n    Map<K, List<V>> read(List<? extends K> keys);\n    void write(Map<? super K, ? extends List<V>> values) throws Exception;\n}\nabstract class Generic {\n    protected abstract <T extends Comparable<T>> T choose(T left, T right);\n    public Object make() { return new Runnable() { public void run() {} }; }\n    public Class<?> type() { return String.class; }\n    public long number() { return 0xFFL + 0b1010 + 077 + 1_000L; }\n    public double floating() { return 1.25e-2 + 0x1.fp3; }\n}\n"
  assert_eq(grammar.parse_source(source) |> result.map((_) => true), ok(true))
  let tokens = lexer.scan(source, false)!
  let dynamic = parser.parse(grammar.rules(), bytes.from_string(source), tokens)!
  let compiled = parser.parse_with(table.compiled(), bytes.from_string(source), tokens)!
  assert_eq(tree.sexp(dynamic.root, dynamic.names), tree.sexp(compiled.root, compiled.names))
}

test "model.java core declarations and bodies parse" {
  let source = "package demo.model;\nimport java.util.List;\nimport java.util.ArrayList;\n/** A UTF-8 source fixture: 日本語 */\n@Deprecated\npublic class Box<T extends Number & Comparable<T>> implements Iterable<T> {\n    private final List<T> values = new ArrayList<>();\n    public Box(T value) { values.add(value); }\n    public T first() { return values.get(0); }\n    public <U> U map(U value) throws Exception { return value; }\n    public int sum(int start) {\n        int total = start;\n        for (int i = 0; i < values.size(); i++) { total += i; }\n        for (T item : values) { if (item == null) continue; }\n        while (total < 10) total++;\n        do { total--; } while (total > 10);\n        return total;\n    }\n    public static class Nested { public int value; }\n}\ninterface View<T> { T first(); default boolean empty() { return false; } }\nrecord Pair<T>(T first, T second) implements java.io.Serializable {}\nenum Color { RED, GREEN, BLUE; public String label() { return this.toString(); } }\n"
  assert_eq(grammar.parse_source(source) |> result.map((_) => true), ok(true))
  let tokens = lexer.scan(source, false)!
  let dynamic = parser.parse(grammar.rules(), bytes.from_string(source), tokens)!
  let compiled = parser.parse_with(table.compiled(), bytes.from_string(source), tokens)!
  assert_eq(tree.sexp(dynamic.root, dynamic.names), tree.sexp(compiled.root, compiled.names))
}

test "statements.java core declarations and bodies parse" {
  let source = "class Worker {\n    private int count = 0, limit = 3;\n    private String café = \"hello \\\\ world\";\n    private char mark = '\\n';\n    private String block = \"\"\"\n        class Invisible { }\n        東京\n        \"\"\";\n    public Worker() { this(1); }\n    public Worker(int start) { this.count = start; }\n    public int run() {\n        Runnable callback = () -> { count++; };\n        java.util.function.Function<Integer,Integer> add = x -> x + 1;\n        int[] numbers = new int[] {1, 2, 3};\n        try (Resource input = open()) {\n            synchronized (this) { callback.run(); }\n        } catch (FirstException | SecondException error) { throw error; }\n        finally { count = 0; }\n        switch (count) { case 0: count++; break; default: return -1; }\n        assert count >= 0 : \"negative\";\n        return (count << 1) + (count >> 1);\n    }\n}\n@interface Label { String value() default \"x\"; }\nrecord Position(int x, int y) { public Position { if (x < 0) throw new IllegalArgumentException(); } }\nclass 東京 { public String 挨拶() { return \"こんにちは\"; } }\n"
  assert_eq(grammar.parse_source(source) |> result.map((_) => true), ok(true))
  let tokens = lexer.scan(source, false)!
  let dynamic = parser.parse(grammar.rules(), bytes.from_string(source), tokens)!
  let compiled = parser.parse_with(table.compiled(), bytes.from_string(source), tokens)!
  assert_eq(tree.sexp(dynamic.root, dynamic.names), tree.sexp(compiled.root, compiled.names))
}

test "binary_float.java is rejected rather than balanced-token accepted" {
  assert(result.is_err(grammar.parse_source("class Broken { int value = 0b1f; }\n")))
}

test "broken_body.java is rejected rather than balanced-token accepted" {
  assert(result.is_err(grammar.parse_source("class Broken { void run() { return 1 + ; } }\n")))
}

test "broken_method.java is rejected rather than balanced-token accepted" {
  assert(result.is_err(grammar.parse_source("class Broken { public int run( { return 1; } }\n")))
}

test "generic_gap.java is rejected rather than balanced-token accepted" {
  assert(result.is_err(grammar.parse_source("class Broken { List<int,> value; }\n")))
}

test "missing_expression.java is rejected rather than balanced-token accepted" {
  assert(result.is_err(grammar.parse_source("class Missing { int value = ; }\n")))
}

test "missing_semicolon.java is rejected rather than balanced-token accepted" {
  assert(result.is_err(grammar.parse_source("class Broken { int value = 1 }\n")))
}

test "try_without_handler.java is rejected rather than balanced-token accepted" {
  assert(result.is_err(grammar.parse_source("class Broken { void run() { try {} } }\n")))
}

test "unclosed_class.java is rejected rather than balanced-token accepted" {
  assert(result.is_err(grammar.parse_source("class Broken { int value;\n")))
}

test "unclosed_string.java is rejected rather than balanced-token accepted" {
  assert(result.is_err(grammar.parse_source("class Broken { string value = \"unterminated; }\n")))
}

test "unicode_symbol.java is rejected rather than balanced-token accepted" {
  assert(result.is_err(grammar.parse_source("class 🪨 {}\n")))
}

test "nested declarations use complete byte ranges and method owners" {
  let source = "// 日本語\nclass Outer { int count; class Inner { int Value() { return 1; } } }"
  let raw = bytes.from_string(source)
  let tokens = lexer.scan(source, false)!
  let parsed = parser.parse_with(table.compiled(), raw, tokens)!
  let outline = tags.outline(parsed.root, tokens, raw, parsed.names, ".", symbols.symbol_rules())
  assert(list.contains(outline, "L2-2 class Outer"))
  assert(list.contains(outline, "    L2-2 method Inner.Value"))
}

test "qualified enclosing this expressions retain grammar and table parity" {
  let source = "// Qualified enclosing-instance expressions preserve the original UTF-8 bytes.\nclass Outer {\n    int value;\n    void clear() { value = 0; }\n    class Inner {\n        void reset() { Outer.this.clear(); }\n        Outer owner() { return Outer.this; }\n        int read() { return Outer.this.value; }\n        class Deep {\n            Inner owner() { return Outer.Inner.this; }\n        }\n    }\n}\nclass 外側 {\n    class 内側 { 外側 owner() { return 外側.this; } }\n}\n"
  let tokens = lexer.scan(source, false)!
  let dynamic = parser.parse(grammar.rules(), bytes.from_string(source), tokens)!
  let compiled = parser.parse_with(table.compiled(), bytes.from_string(source), tokens)!
  assert_eq(tree.sexp(dynamic.root, dynamic.names), tree.sexp(compiled.root, compiled.names))
}

test "qualified this does not accept an unfinished member" {
  assert(result.is_err(grammar.parse_source("class Broken { void run() { Outer.this.; } }")))
  assert(result.is_err(grammar.parse_source("class this {}")))
}

test "qualified this only follows a qualified type name" {
  assert(result.is_err(grammar.parse_source("class Broken { Object value() { return 1 .this; } }\n")))
  assert(result.is_err(grammar.parse_source("class Broken { Object value() { return make().this; } }\n")))
  assert(result.is_err(grammar.parse_source("class Broken { Object value() { return (Outer).this; } }\n")))
  assert(result.is_err(grammar.parse_source("class Broken { Object value() { return Outer.<String>this; } }\n")))
}
