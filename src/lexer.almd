// Original byte-preserving scanner. Unicode category tables are pinned in unicode.almd.
import gramide.tree
import gramide.lex
import self.unicode

let JAVA = true
let KEYWORDS = ["abstract", "assert", "boolean", "break", "byte", "case", "catch", "char", "class", "const", "continue", "default", "do", "double", "else", "enum", "extends", "final", "finally", "float", "for", "goto", "if", "implements", "import", "instanceof", "int", "interface", "long", "native", "new", "package", "private", "protected", "public", "return", "short", "static", "strictfp", "super", "switch", "synchronized", "this", "throw", "throws", "transient", "try", "void", "volatile", "while", "true", "false", "null", "record", "sealed", "permits", "non-sealed", "var", "yield"]
// `>` stays separate for nested generics. Grammar joins shift/comparison operators.
let OPERATORS = ["<<=", "...", "??=", "=>", "->", "::", "?.", "??", "++", "--", "&&", "||", "==", "!=", "<=", "+=", "-=", "*=", "/=", "%=", "&=", "|=", "^=", "<<", "+", "-", "*", "/", "%", "&", "|", "^", "<", ">", "=", "!", "~", "?", ":", ".", ",", ";", "(", ")", "[", "]", "{", "}", "@"]
type Tables = { starts: List[Int], continues: List[Int], operators: List[Bytes] }
fn prepare() -> Tables = Tables { starts: unicode.starts(), continues: unicode.continues(), operators: list.map(OPERATORS, (op) => bytes.from_string(op)) }
fn b(source: Bytes, at: Int) -> Int = bytes.get_or(source, at, -1)
fn digit(c: Int) -> Bool = c >= 48 and c <= 57
fn hex(c: Int) -> Bool = digit(c) or (c >= 65 and c <= 70) or (c >= 97 and c <= 102)
fn alpha(c: Int) -> Bool = c == 95 or (JAVA and c == 36) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122)
fn width(c: Int) -> Int = if c < 128 then 1 else if c < 224 then 2 else if c < 240 then 3 else 4
fn codepoint(source: Bytes, at: Int) -> Int = if b(source, at) < 128 then b(source, at) else string.codepoint(bytes.to_string_lossy(bytes.slice(source, at, at + width(b(source, at))))) ?? -1
fn ident_start(t: Tables, cp: Int) -> Bool = alpha(cp) or (cp >= 128 and unicode.contains(t.starts, cp))
fn ident_continue(t: Tables, cp: Int) -> Bool = alpha(cp) or digit(cp) or (cp >= 128 and unicode.contains(t.continues, cp))
fn matches(source: Bytes, at: Int, pat: Bytes) -> Bool = {
  var i = 0
  var yes = true
  while yes and i < bytes.len(pat) {
    if b(source, at + i) != b(pat, i) then yes = false else i = i + 1
  }
  yes
}
fn operator_width(source: Bytes, at: Int, tables: Tables) -> Int = {
  var result = 0
  for op in tables.operators {
    if result == 0 and b(op, 0) == b(source, at) and matches(source, at, op) then result = bytes.len(op) else ()
  }
  result
}

// Return the byte after an escape, or -1. Literal validation does not decode text.
fn escape_end(source: Bytes, at: Int) -> Int = {
  let c = b(source, at + 1)
  if list.contains([98, 116, 110, 102, 114, 34, 39, 92], c) or (JAVA and c == 115) or (not JAVA and list.contains([48, 97, 118], c)) then at + 2
  else if c == 117 or (not JAVA and c == 85) then {
    let size = if c == 85 then 8 else 4
    var i = at + 2
    while i < at + 2 + size and hex(b(source, i)) { i = i + 1 }
    if i == at + 2 + size then i else -1
  }
  else if not JAVA and c == 120 then {
    var i = at + 2
    while i < at + 6 and hex(b(source, i)) { i = i + 1 }
    if i > at + 2 then i else -1
  }
  else if JAVA and c >= 48 and c <= 55 then {
    var i = at + 2
    let limit = at + (if c <= 51 then 4 else 3)
    while i < limit and b(source, i) >= 48 and b(source, i) <= 55 { i = i + 1 }
    i
  } else -1
}

// (end, valid). Comments and literal bodies are never reparsed as declarations.
fn quoted(source: Bytes, start: Int, verbatim: Bool, text_block: Bool) -> (Int, Bool) = {
  let q = if verbatim then start + 1 else start
  let quote = b(source, q)
  var i = q + (if text_block then 3 else 1)
  var valid = true
  var closed = false
  var units = 0
  if text_block then {
    while b(source, i) == 32 or b(source, i) == 9 or b(source, i) == 12 { i = i + 1 }
    if b(source, i) != 10 and b(source, i) != 13 then valid = false else ()
  } else ()
  while i < bytes.len(source) and not closed {
    let c = b(source, i)
    if text_block and c == 34 and b(source, i + 1) == 34 and b(source, i + 2) == 34 then { i = i + 3; closed = true }
    else if not text_block and c == quote then {
      if verbatim and b(source, i + 1) == quote then { i = i + 2; units = units + 1 }
      else { i = i + 1; closed = true }
    }
    else if not verbatim and c == 92 then {
      let end = escape_end(source, i)
      if text_block and (b(source, i + 1) == 10 or b(source, i + 1) == 13) then i = i + 2
      else if end < 0 then { valid = false; i = i + 1 }
      else i = end
      units = units + 1
    }
    else if not text_block and not verbatim and (c == 10 or c == 13) then { valid = false; closed = true }
    else { units = units + (if codepoint(source, i) > 65535 then 2 else 1); i = i + width(c) }
  }
  (i, valid and closed and (quote != 39 or units == 1))
}

fn based_digit(c: Int, base: Int) -> Bool = if base == 16 then hex(c) else if base == 2 then c == 48 or c == 49 else digit(c)
// Separator runs must stay between digits; suffixes are handled separately.
fn digits(source: Bytes, start: Int, base: Int) -> (Int, Bool, Bool) = {
  var i = start
  var saw = false
  var last_digit = false
  var valid = true
  while based_digit(b(source, i), base) or b(source, i) == 95 {
    if b(source, i) == 95 then { if not saw then valid = false else (); last_digit = false }
    else { saw = true; last_digit = true }
    i = i + 1
  }
  (i, valid and (not saw or last_digit), saw)
}
fn number(source: Bytes, start: Int) -> (Int, Bool) = {
  let base = if b(source, start) == 48 and (b(source, start + 1) == 120 or b(source, start + 1) == 88) then 16
    else if b(source, start) == 48 and (b(source, start + 1) == 98 or b(source, start + 1) == 66) then 2 else 10
  let first = start + (if base == 10 then 0 else 2)
  let (end, valid_digits, saw) = digits(source, first, base)
  var i = end
  var valid = valid_digits
  var has_digits = saw
  var floating = false
  if base != 2 and b(source, i) == 46 and b(source, i + 1) != 46 and (JAVA or digit(b(source, i + 1))) then {
    floating = true
    let (after, good, present) = digits(source, i + 1, base)
    valid = valid and good
    has_digits = has_digits or present
    i = after
  } else ()
  let exponent = if base == 16 then b(source, i) == 112 or b(source, i) == 80 else b(source, i) == 101 or b(source, i) == 69
  if exponent then {
    floating = true
    i = i + 1
    if b(source, i) == 43 or b(source, i) == 45 then i = i + 1 else ()
    let (after, good, present) = digits(source, i, 10)
    valid = valid and good and present
    i = after
  } else if base == 16 and floating then valid = false else ()
  if JAVA then {
    if list.contains([102, 70, 100, 68], b(source, i)) then { floating = true; if base == 2 then valid = false else (); i = i + 1 }
    else if b(source, i) == 108 or b(source, i) == 76 then { if floating then valid = false else (); i = i + 1 }
    else ()
    // Java's unsuffixed leading-zero integer is octal.
    if base == 10 and not floating and b(source, start) == 48 then {
      var k = start
      while k < i { if b(source, k) == 56 or b(source, k) == 57 then valid = false else (); k = k + 1 }
    } else ()
  } else {
    if base == 16 and floating then valid = false else ()
    if list.contains([102, 70, 100, 68, 109, 77], b(source, i)) then { floating = true; if base == 2 then valid = false else (); i = i + 1 }
    else if list.contains([117, 85, 108, 76], b(source, i)) then {
      if floating then valid = false else ()
      let suffix = b(source, i)
      i = i + 1
      if (suffix == 117 or suffix == 85) and (b(source, i) == 108 or b(source, i) == 76) then i = i + 1
      else if (suffix == 108 or suffix == 76) and (b(source, i) == 117 or b(source, i) == 85) then i = i + 1 else ()
    } else ()
  }
  if alpha(b(source, i)) or digit(b(source, i)) then {
    valid = false
    while alpha(b(source, i)) or digit(b(source, i)) { i = i + 1 }
  } else ()
  (i, valid and has_digits)
}

// gramide v0.2.11 reports LF-based line coordinates. Refuse lone CR
// rather than exporting a complete symbol with an inconsistent end line.
fn source_line_endings(source: Bytes) -> Result[Unit, lex.LexError] = {
  var i = 0
  var line = 1
  var base = 0
  while i < bytes.len(source) {
    guard bytes.get_or(source, i, -1) != 13 or bytes.get_or(source, i + 1, -1) == 10 else
      err(lex.LexError { line: line, col: i - base + 1, message: "core reader supports LF or CRLF line endings, not lone CR" })
    if bytes.get_or(source, i, -1) == 10 then { line = line + 1; base = i + 1 } else ()
    i = i + 1
  }
  ok(())
}

fn scan_prepared(text: String, tables: Tables, recovering: Bool) -> Result[List[tree.Token], lex.LexError] = {
  let source = bytes.from_string(text)
  if not recovering then source_line_endings(source)! else ()
  let n = bytes.len(source)
  var tokens: List[tree.Token] = []
  var i = 0
  var line = 1
  var line_start = 0
  while i < n {
    let start = i
    let token_line = line
    let token_col = start - line_start + 1
    let c = b(source, i)
    var kind = tree.T_NONE
    var issue = ""
    if i == 0 and c == 239 and b(source, 1) == 187 and b(source, 2) == 191 then i = 3
    else if list.contains([32, 9, 10, 13, 12], c) then i = i + 1
    else if c == 47 and b(source, i + 1) == 47 then {
      i = i + 2
      while i < n and b(source, i) != 10 and b(source, i) != 13 { i = i + 1 }
    }
    else if c == 47 and b(source, i + 1) == 42 then {
      i = i + 2
      while i < n and not (b(source, i) == 42 and b(source, i + 1) == 47) { i = i + 1 }
      if i == n then issue = "unterminated block comment" else i = i + 2
    }
    else if c == 34 or c == 39 or (not JAVA and c == 64 and b(source, i + 1) == 34) then {
      let verbatim = c == 64
      let triple = c == 34 and b(source, i + 1) == 34 and b(source, i + 2) == 34
      let (end, good) = quoted(source, i, verbatim, JAVA and triple)
      i = end
      kind = if c == 39 then tree.T_RUNE else tree.T_STRING
      if triple and not JAVA then issue = "C# raw strings are outside this core reader"
      else if not good then issue = "invalid or unterminated literal" else ()
    }
    else if digit(c) or (c == 46 and digit(b(source, i + 1))) then {
      let (end, good) = number(source, i)
      i = end
      kind = tree.T_NUMBER
      if not good then issue = "invalid numeric literal" else ()
    }
    else if ident_start(tables, codepoint(source, i)) or (not JAVA and c == 64 and ident_start(tables, codepoint(source, i + 1))) then {
      let escaped = c == 64
      if escaped then i = i + 1 else ()
      i = i + width(b(source, i))
      while i < n and ident_continue(tables, codepoint(source, i)) { i = i + width(b(source, i)) }
      let word = bytes.to_string_lossy(bytes.slice(source, start, i))
      kind = if not escaped and list.contains(KEYWORDS, word) then tree.T_KEYWORD else tree.T_IDENTIFIER
    }
    else {
      let count = operator_width(source, i, tables)
      if count > 0 then { i = i + count; kind = tree.T_PUNCT }
      else { i = i + width(c); issue = "unsupported or invalid source character" }
    }
    if issue != "" then {
      guard recovering else err(lex.LexError { line: token_line, col: token_col, message: issue })
      kind = tree.T_ERROR
    } else ()
    if kind != tree.T_NONE then list.push(tokens, tree.Token { kind: kind, start: start, end: i, line: token_line, col: token_col }) else ()
    var at = start
    while at < i {
      if b(source, at) == 10 then {
        line = line + 1
        line_start = at + 1
      } else ()
      at = at + 1
    }
  }
  list.push(tokens, tree.Token { kind: tree.T_EOF, start: n, end: n, line: line, col: n - line_start + 1 })
  ok(tokens)
}
fn scan(source: String, recovering: Bool) -> Result[List[tree.Token], lex.LexError] = scan_prepared(source, prepare(), recovering)

test "Unicode names preserve byte offsets and comments do not leak" {
  let source = "/* class Fake {} */\r\nclass 東京 { int café; }"
  let tokens = scan(source, false)!
  assert_eq(lex.texts(bytes.from_string(source), tokens), ["class", "東京", "{", "int", "café", ";", "}", ""])
  let name = list.get(tokens, 1)!
  assert_eq(name.end - name.start, 6)
  assert_eq(name.line, 2)
  assert(result.is_err(scan("class 🪨 {}", false)))
}

test "strict lexer rejects malformed literals and recovery retains errors" {
  for source in ["\"unterminated", "/* unterminated", "'ab'", "0x", "1e+", "123name"] {
    assert(result.is_err(scan(source, false)))
    let tokens = scan(source, true)!
    assert(list.any(tokens, (token) => token.kind == tree.T_ERROR))
  }
}

test "core readers keep LF and CRLF ranges and reject lone CR" {
  assert(result.is_err(scan("/* one\rtwo */", false)))
  assert(result.is_err(scan("\r", false)))
  assert(result.is_ok(scan("\r\n", false)))
}
